{
  "name": "any-listen",
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm build:desktop",
    "build:desktop": "pnpm -F @shared/scripts build:desktop:win",
    "build:dir": "pnpm -F @shared/scripts build:desktop:dir",
    "build:theme": "pnpm -F @shared/theme build:theme",
    "build:web": "pnpm -F @shared/scripts build:web",
    "ckdep": "pnpm -F @shared/deps-update check",
    "cldep": "rm -rf node_modules && pnpm -r exec rm -rf node_modules",
    "dev": "pnpm dev:desktop",
    "dev:desktop": "pnpm -F @shared/scripts dev:desktop",
    "dev:web": "pnpm -F @shared/scripts dev:web",
    "pi": "pnpm -F @shared/scripts postinstall",
    "pub": "pnpm -F @shared/publish pub --commit",
    "pub:desktop": "pnpm -F @shared/publish pub --type=desktop --commit",
    "pub:web": "pnpm -F @shared/publish pub --type=web-server --commit",
    "fmt": "oxfmt"
  },
  "devDependencies": {
    "@any-listen/eslint": "workspace:@shared/eslint@^",
    "oxfmt": "^0.80.0",
    "prettier-plugin-organize-imports": "^4.3.0"
  },
  "engines": {
    "node": ">=22.12.0 || ^20.19.0"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32"
}
